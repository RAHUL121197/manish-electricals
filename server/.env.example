# PostgreSQL / Neon connection string
# Example: postgresql://user:password@ep-xxxx.neon.tech/manish_electricals?sslmode=require
DATABASE_URL=

# JWT secret used to sign authentication tokens (use a long random string in production)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Server port
PORT=5000

# Comma separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# Node environment
NODE_ENV=development
